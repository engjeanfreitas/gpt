{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempo",
  "version": "0.1.5",
  "identifier": "com.tempo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5OTZGMUY1ODRENjA1MjAKUldRZ0JkYUU5ZkdXdVE1ZlVva1FMV0dxaXhTblQwNWxaNmwvNG5SenZ4Yjc0Y0trOVM1bzZxVG4K",
      "endpoints": [
        "https://raw.githubusercontent.com/engjeanfreitas/gpt/main/updates/windows-x64.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
